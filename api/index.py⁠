    return {}

SIGNOS = [
    "Áries", "Touro", "Gêmeos", "Câncer", 
    "Leão", "Virgem", "Libra", "Escorpião", 
    "Sagitário", "Capricórnio", "Aquário", "Peixes"
]

def formatar_posicao(longitude, velocidade=0.0):
    longitude = float(longitude) % 360
    signo_idx = int(longitude // 30)
    grau_no_signo = longitude % 30
    graus_int = int(grau_no_signo)
    minutos = int((grau_no_signo - graus_int) * 60)
    return {
        "longitude_total": round(longitude, 4),
        "signo": SIGNOS[signo_idx],
        "grau": graus_int,
        "minuto": minutos,
        "retrogrado": velocidade < 0
    }

def buscar_sizigia_prenatal(jd_nascimento):
    jd_teste = jd_nascimento
    for _ in range(60):
        jd_teste -= 0.5
        pos_sol, _ = swe.calc_ut(jd_teste, swe.SUN)
        pos_lua, _ = swe.calc_ut(jd_teste, swe.MOON)
        elongacao = (pos_lua[0] - pos_sol[0]) % 360
        if elongacao < 6.0 or abs(elongacao - 180) < 6.0 or elongacao > 354.0:
            return pos_lua[0]
    return 0.0

@app.get("/")
@app.get("/api")
def calcular_mapa_completo(
    data: str = Query("1989-10-09"),
    hora: str = Query("10:59"),
    fuso: float = Query(-3.0),
    lat: float = Query(-23.5505),
    lon: float = Query(-46.6333)
):
    dt_local = datetime.strptime(f"{data} {hora}", "%Y-%m-%d %H:%M")
    dt_utc = dt_local - timedelta(hours=fuso)
    hora_decimal = dt_utc.hour + (dt_utc.minute / 60.0) + (dt_utc.second / 3600.0)
    jd = swe.julday(dt_utc.year, dt_utc.month, dt_utc.day, hora_decimal)

    resultado = {}

    # 1. Planetas Clássicos
    planetas = {
        "Sol": swe.SUN, "Lua": swe.MOON, "Mercúrio": swe.MERCURY,
        "Vênus": swe.VENUS, "Marte": swe.MARS, "Júpiter": swe.JUPITER, "Saturno": swe.SATURN
    }
    for nome, pid in planetas.items():
        pos, _ = swe.calc_ut(jd, pid)
        resultado[nome] = formatar_posicao(pos[0], pos[3])

    # 2. Ângulos (Ascendente e MC)
    cuspes, ascmc = swe.houses(jd, lat, lon, b'W')
    resultado["Ascendente"] = formatar_posicao(ascmc[0])
    resultado["MC"] = formatar_posicao(ascmc[1])

    # 3. Nodo Norte
    pos_nodo, _ = swe.calc_ut(jd, swe.TRUE_NODE)
    resultado["Nodo_Norte"] = formatar_posicao(pos_nodo[0], pos_nodo[3])

    # 4. Sizígia Pré-Natal
    pos_sizigia = buscar_sizigia_prenatal(jd)
    resultado["Sizigia"] = formatar_posicao(pos_sizigia)

    return resultado
